---
import Base from './Base.astro';
interface Props { title: string; description: string; updated?: string }
const { title, description, updated } = Astro.props;
---
<Base title={title} description={description}>
  <article class="prose page">
    <h1>{title}</h1>
    {updated && <p class="muted">Last updated {updated}</p>}
    <slot />
  </article>
</Base>
<style>.page { margin: 32px 0; }</style>
