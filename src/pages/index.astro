---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { categories } from '../data/categories';

const latest = (await getCollection('articles', ({ data }) => !data.draft))
  .sort((a, b) => b.data.updated.valueOf() - a.data.updated.valueOf())
  .slice(0, 6);
---
<Base
  title="GarageRecoveryLab: Honest Reviews of Saunas, Cold Plunges and Hot Tubs"
  description="Independent reviews and buying guides for home saunas, cold plunges, hot tubs, massage chairs and garage gym gear, with real running costs."
>
  <section class="hero">
    <p class="eyebrow">Heat. Cold. Recovery.</p>
    <h1>Buy the right sauna, plunge or hot tub the first time.</h1>
    <p class="lead">These are $3,000 to $15,000 purchases. We compare them on what the spec sheets leave out: heat-up time, running cost per session, install and wiring needs, and the warranty fine print.</p>
    <a class="btn" href="/how-we-test/">How we test</a>
  </section>

  <section>
    <h2>Browse by category</h2>
    <div class="grid">
      {categories.map((c) => (
        <a class="card link" href={`/${c.slug}/`}>
          <strong>{c.title}</strong>
          <span class="muted">{c.blurb}</span>
        </a>
      ))}
    </div>
  </section>

  {latest.length > 0 && (
    <section>
      <h2>Latest guides</h2>
      <div class="grid">
        {latest.map((a) => (
          <a class="card link" href={`/${a.id}/`}>
            <span class="eyebrow">{a.data.type}</span>
            <strong>{a.data.title}</strong>
          </a>
        ))}
      </div>
    </section>
  )}
</Base>
<style>
  .hero { padding: 56px 0 24px; max-width: 760px; }
  .hero h1 { font-size: clamp(2.2rem, 5vw, 3.2rem); }
  .lead { font-size: 1.15rem; color: var(--muted); margin-bottom: 24px; }
  .link { display: flex; flex-direction: column; gap: 6px; text-decoration: none; color: var(--ink); }
  .link:hover { border-color: var(--ember); }
</style>
