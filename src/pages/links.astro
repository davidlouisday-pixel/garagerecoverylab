---
// Instagram bio link: the newest guides first, so a reader who saw a carousel finds its guide at the top.
import { getCollection } from 'astro:content';
import { isLive } from '../data/live';
import Base from '../layouts/Base.astro';

const guides = (await getCollection('articles', ({ data }) => isLive(data)))
  .sort((a, b) => b.data.published.valueOf() - a.data.published.valueOf())
  .slice(0, 15);
---
<Base title="GarageRecoveryLab: Latest Guides" description="The newest GarageRecoveryLab guides, as posted on Instagram." noindex>
  <section class="container links">
    <h1>Latest guides</h1>
    <p class="sub">Saw a post on Instagram? The newest guide is at the top.</p>
    <ol>
      {guides.map((g) => (
        <li><a href={`/${g.id}/`}>{g.data.title}</a></li>
      ))}
    </ol>
    <p class="more"><a href="/">All guides and categories</a></p>
  </section>
</Base>

<style>
  .links { max-width: 40rem; padding-block: 2.5rem 4rem; }
  .sub { margin-top: 0.5rem; }
  ol { list-style: none; padding: 0; margin: 2rem 0 0; display: grid; gap: 0.75rem; }
  li a {
    display: block; padding: 1rem 1.25rem; border: 1px solid currentColor; border-radius: 0.5rem;
    text-decoration: none; font-weight: 600; line-height: 1.3;
  }
  li a:hover, li a:focus-visible { background: color-mix(in oklch, currentColor 8%, transparent); }
  .more { margin-top: 2rem; }
</style>
