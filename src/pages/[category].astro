---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { categories } from '../data/categories';
import Hero, { pexelsSrc } from '../components/Hero.astro';
import { typeLabel } from '../data/labels';

export async function getStaticPaths() {
  return categories.map((c) => ({ params: { category: c.slug }, props: { cat: c } }));
}
const { cat } = Astro.props;
const articles = (await getCollection('articles', ({ data }) => !data.draft && data.category === cat.key))
  .sort((a, b) => b.data.updated.valueOf() - a.data.updated.valueOf());
---
<Base title={`${cat.title}: Reviews and Buying Guides`} description={cat.blurb} image={cat.hero && pexelsSrc(cat.hero.pexelsId)}>
  <section class="container hub" data-temp={cat.temp}>
    <div class="hub-head">
      <div>
        <h1>{cat.title}</h1>
        <p class="standfirst">{cat.blurb}</p>
      </div>
      {cat.hero && <Hero pexelsId={cat.hero.pexelsId} alt={cat.hero.alt} class="hub-photo" />}
    </div>
    <h2 class="hub-sub">{articles.length === 0 ? 'Coming soon' : `${articles.length} ${articles.length === 1 ? 'guide' : 'guides'}`}</h2>
    {articles.length === 0 ? (
      <p class="muted">Our first {cat.title.toLowerCase()} guides are in progress.</p>
    ) : (
      <ol class="rows">
        {articles.map((a) => (
          <li data-temp={cat.temp}>
            <a href={`/${a.id}/`}>
              <h3>{a.data.title}</h3>
              <p>{a.data.description}</p>
              <span class="label">{typeLabel[a.data.type] ?? a.data.type}</span>
            </a>
          </li>
        ))}
      </ol>
    )}
  </section>
</Base>
<style>
  .hub { padding-top: var(--space-2xl); }
  .hub-head { display: grid; grid-template-columns: minmax(0, 6fr) minmax(0, 6fr); gap: var(--gap-columns); align-items: end; }
  .hub-head .standfirst { margin-top: var(--space-lg); }
  .hub h1 { border-top: 6px solid var(--temp, var(--color-ink)); padding-top: var(--space-md); }
  .hub-sub { font-size: var(--text-2xl); margin: var(--section-gap-s) 0 var(--space-md); }
  @media (max-width: 52rem) { .hub-head { grid-template-columns: minmax(0, 1fr); } }
</style>
