---
// Renders every published article at /<slug>/.
import { getCollection, render } from 'astro:content';
import { isLive } from '../data/live';
import Base from '../layouts/Base.astro';
import Disclosure from '../components/Disclosure.astro';
import QuickAnswer from '../components/QuickAnswer.astro';
import ComparisonTable from '../components/ComparisonTable.astro';
import Faq from '../components/Faq.astro';
import AuthorBox from '../components/AuthorBox.astro';
import RelatedGuides from '../components/RelatedGuides.astro';
import Hero, { pexelsSrc } from '../components/Hero.astro';
import { typeLabel, fmtDate } from '../data/labels';
import { categories, tempOf } from '../data/categories';

export async function getStaticPaths() {
  const articles = await getCollection('articles', ({ data }) => import.meta.env.DEV || isLive(data));
  return articles.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const d = entry.data;
const url = new URL(`/${entry.id}/`, Astro.site).toString();
const cat = categories.find((c) => c.key === d.category);
const toc = headings.filter((h) => h.depth === 2);
const temp = tempOf(d.category);

const jsonLd: Record<string, unknown>[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: d.title,
    description: d.description,
    datePublished: d.published.toISOString(),
    dateModified: d.updated.toISOString(),
    author: { '@type': 'Person', name: d.author },
    mainEntityOfPage: url,
  },
];
if (d.faq.length) {
  jsonLd.push({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: d.faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  });
}
---
<Base title={d.title} description={d.description} jsonLd={jsonLd} noindex={d.draft} image={d.hero && pexelsSrc(d.hero.pexelsId)}>
  <article class="container article" data-temp={temp}>
    <header class="article-head">
      {cat && <p class="label crumbs"><a href={`/${cat.slug}/`}>{cat.title}</a></p>}
      <h1>{d.title}</h1>
      <p class="standfirst">{d.description}</p>
      <p class="label byline">
        {typeLabel[d.type] ?? 'Article'} by <a href="/about/">{d.author}</a>. Updated <time datetime={d.updated.toISOString().slice(0, 10)}>{fmtDate(d.updated)}</time>.
      </p>
    </header>

    {d.hero && <Hero pexelsId={d.hero.pexelsId} alt={d.hero.alt} class="article-photo" />}

    <div class="article-grid">
      {toc.length > 2 && (
        <nav class="toc" aria-label="On this page">
          <p class="label">On this page</p>
          <ol>{toc.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol>
        </nav>
      )}
      <div class="article-main">
        <Disclosure />
        <QuickAnswer text={d.quickAnswer} temp={temp} />
        {d.products.length > 0 && <ComparisonTable products={d.products} />}
        <div class="body"><Content /></div>
        <Faq items={d.faq} />
        <AuthorBox author={d.author} />
        <RelatedGuides id={entry.id} category={d.category} />
      </div>
    </div>
  </article>
</Base>
<style>
  .article { padding-top: var(--space-2xl); }
  .article-head { max-width: 1040px; }
  .crumbs { margin-bottom: var(--space-md); }
  .crumbs a { color: var(--temp, var(--color-ink)); font-weight: 700; }
  .article-head h1 { max-width: 22ch; }
  .article-head .standfirst { margin-top: var(--space-lg); }
  .byline { margin-top: var(--space-lg); color: var(--color-ink-2); }
  .byline a { color: var(--color-ink); }
  :global(.article-photo) { margin-top: var(--space-xl); max-width: 1040px; }

  .article-grid { display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--space-2xl); margin-top: var(--space-xl); }
  .article-main { max-width: 820px; min-width: 0; }
  @media (min-width: 72rem) {
    .article-grid { grid-template-columns: minmax(0, 14rem) minmax(0, 820px); }
    .toc { position: sticky; top: var(--space-lg); align-self: start; }
  }
  .toc { border-top: var(--rule-heavy) solid var(--temp, var(--color-ink)); padding-top: var(--space-sm); }
  .toc ol { list-style: none; margin: var(--space-sm) 0 0; padding: 0; display: grid; gap: var(--space-xs); font-family: var(--font-display); font-variation-settings: "opsz" 12; font-weight: 500; font-size: var(--text-sm); line-height: 1.3; }
  .toc a { text-decoration: none; color: var(--color-ink-2); }
  .toc a:hover { color: var(--color-ink); text-decoration: underline; text-decoration-color: var(--color-accent); }
  @media (max-width: 71.99rem) { .toc ol { grid-template-columns: repeat(auto-fill, minmax(min(100%, 14rem), 1fr)); column-gap: var(--space-lg); } }

  .body { margin-top: var(--space-xl); }
  .body :global(h2) { font-size: var(--text-2xl); max-width: 26ch; margin-top: var(--space-2xl); padding-top: var(--space-md); border-top: 2px solid var(--temp, var(--color-rule-2)); scroll-margin-top: var(--space-lg); }
  .body :global(h3) { font-size: var(--text-xl); margin-top: var(--space-xl); }
  .body :global(p), .body :global(ul), .body :global(ol) { margin-top: var(--space-md); max-width: 65ch; }
  .body :global(li + li) { margin-top: var(--space-xs); }
  .body :global(strong) { color: var(--color-ink); font-weight: 600; }
  .body :global(table) { display: block; overflow-x: auto; margin-top: var(--space-lg); border-top: var(--rule-heavy) solid var(--temp, var(--color-ink)); }
  .body :global(h2 + p), .body :global(h3 + p) { margin-top: var(--space-sm); }
  .body :global(p > img) { display: block; width: 100%; max-width: 420px; height: auto; margin-top: var(--space-lg); }
</style>
