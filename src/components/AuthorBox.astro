---
interface Props { author: string }
const { author } = Astro.props;
const isCole = author === 'Cole Garrison';
---
<aside class="author well" aria-labelledby="author-name">
  <h2 id="author-name" class="author-name">Written by {author}</h2>
  {isCole ? (
    <p>Cole trains seven days a week and uses the electric sauna at his gym four or more times a week after training. He spent years training in a home gym before moving to a commercial gym. <a href="/about/">More about Cole</a> and <a href="/how-we-test/">how we research</a>.</p>
  ) : (
    <p>Read <a href="/how-we-test/">how we test and research</a> and <a href="/about/">who runs this site</a>.</p>
  )}
</aside>
<style>
  .author { margin-top: var(--space-3xl); }
  .author-name { font-size: var(--text-2xl); margin-block: var(--space-2xs) var(--space-sm); }
</style>
