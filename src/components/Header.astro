---
const nav = [
  { href: '/saunas/', label: 'Saunas' },
  { href: '/cold-plunges/', label: 'Cold plunges' },
  { href: '/hot-tubs/', label: 'Hot tubs' },
  { href: '/massage-chairs/', label: 'Massage chairs' },
  { href: '/garage-gym/', label: 'Garage gym' },
];
const path = Astro.url.pathname;
---
<header class="site-header">
  <div class="container">
    <a class="wordmark" href="/" aria-label="GarageRecoveryLab home">
      <svg viewBox="0 0 30 20" aria-hidden="true"><circle class="w-heat" cx="10" cy="10" r="9" fill="currentColor" /><circle class="w-cold" cx="20" cy="10" r="9" fill="currentColor" fill-opacity="0.9" /></svg>
      GarageRecoveryLab
    </a>
    <nav class="main-nav" aria-label="Main">
      {nav.map((n) => <a href={n.href} aria-current={path === n.href ? 'page' : undefined}>{n.label}</a>)}
    </nav>
  </div>
</header>
