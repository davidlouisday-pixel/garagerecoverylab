---
interface Props { pros: string[]; cons: string[] }
const { pros, cons } = Astro.props;
---
{(pros.length > 0 || cons.length > 0) && (
  <div class="pc">
    <div><h3>What we like</h3><ul>{pros.map((p) => <li>{p}</li>)}</ul></div>
    <div><h3>What could be better</h3><ul>{cons.map((c) => <li>{c}</li>)}</ul></div>
  </div>
)}
<style>
  .pc { display: grid; gap: var(--gap-columns); grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr)); margin-block: var(--space-lg); }
  .pc > div { border-top: var(--rule-heavy) solid var(--color-ink); padding-top: var(--space-sm); }
  .pc ul { padding-left: 1.1em; margin: var(--space-xs) 0 0; }
</style>
