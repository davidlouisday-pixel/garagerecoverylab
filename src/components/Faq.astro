---
interface Props { items: { q: string; a: string }[] }
const { items } = Astro.props;
---
{items.length > 0 && (
  <section class="faq">
    <h2>Frequently asked questions</h2>
    {items.map((f) => (
      <details>
        <summary>{f.q}</summary>
        <p>{f.a}</p>
      </details>
    ))}
  </section>
)}
<style>
  details { border-bottom: 1px solid var(--line); padding: 12px 0; }
  summary { font-weight: 600; cursor: pointer; }
</style>
