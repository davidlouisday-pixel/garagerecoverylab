---
import { categories } from '../data/categories';
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="container">
    <div class="cols">
      <div class="about">
        <a class="wordmark" href="/">
          <svg viewBox="0 0 30 20" aria-hidden="true"><circle class="w-heat" cx="10" cy="10" r="9" fill="currentColor" /><circle class="w-cold" cx="20" cy="10" r="9" fill="currentColor" fill-opacity="0.9" /></svg>
          GarageRecoveryLab
        </a>
        <p>Independent reviews of saunas, cold plunges, hot tubs, massage chairs and garage gym gear.</p>
      </div>
      <nav aria-label="Categories">
        <h2>Categories</h2>
        <ul>{categories.map((c) => <li><a href={`/${c.slug}/`}>{c.title}</a></li>)}</ul>
      </nav>
      <nav aria-label="Footer">
        <h2>The site</h2>
        <ul>
          <li><a href="/about/">About</a></li>
          <li><a href="/how-we-test/">How we test</a></li>
          <li><a href="/affiliate-disclosure/">Affiliate disclosure</a></li>
          <li><a href="/privacy/">Privacy</a></li>
          <li><a href="/contact/">Contact</a></li>
        </ul>
      </nav>
    </div>
    <p class="fine">
      © {year} GarageRecoveryLab. We may earn a commission when you buy through links on this site, at no extra cost to you.
      Nothing here is medical advice; talk to your doctor before starting heat or cold therapy. Header photographs via <a href="https://www.pexels.com/" rel="nofollow noopener" target="_blank">Pexels</a>.
    </p>
  </div>
</footer>
