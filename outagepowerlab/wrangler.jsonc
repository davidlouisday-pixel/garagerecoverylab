// Cloudflare Workers Builds config. Static site from ./dist plus worker/index.js for the quote form.
{
  "name": "outagepowerlab",
  "compatibility_date": "2026-11-01",
  "main": "worker/index.js",
  // Build the static site before deploying, in case the dashboard has no build command.
  "build": { "command": "npm run build" },
  // Required by `wrangler preview`, which Workers Builds runs for non-main branches (PR previews).
  "previews": {},
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  }
  // Setup step (see SETUP.md): after creating the D1 database, add
  //   "d1_databases": [{ "binding": "DB", "database_name": "outagepowerlab-leads", "database_id": "<id>" }],
  //   "send_email": [{ "name": "NOTIFY" }],
  //   "vars": { "LEAD_NOTIFY_TO": "<your verified inbox>", "LEAD_NOTIFY_FROM": "leads@<domain>" }
  // Until then the form answers "not open yet, please email us".
}
