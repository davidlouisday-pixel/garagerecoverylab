---
interface Props { items: { q: string; a: string }[] }
const { items } = Astro.props;
---
{items.length > 0 && (
  <section class="faq" aria-labelledby="faq">
    <h2 id="faq">Frequently asked questions</h2>
    <div class="faq-list">
      {items.map((f) => (
        <details>
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>
  </section>
)}
<style>
  .faq { margin-top: var(--space-3xl); }
  .faq h2 { font-size: var(--text-section); margin-bottom: var(--space-lg); }
  .faq-list { border-top: var(--rule-heavy) solid var(--tone, var(--color-ink)); }
  details { border-bottom: var(--rule-hair) solid var(--color-rule); }
  summary { list-style: none; cursor: pointer; display: flex; justify-content: space-between; gap: var(--space-md); padding-block: var(--space-md); font-family: var(--font-display); font-weight: 700; font-variation-settings: "wdth" 75, "opsz" 48; font-size: var(--text-xl); line-height: 1.15; color: var(--color-ink); }
  summary::-webkit-details-marker { display: none; }
  summary::after { content: "+"; font-weight: 500; color: var(--color-muted); transition: transform var(--dur-short) var(--ease-out); }
  details[open] summary::after { transform: rotate(45deg); }
  summary:hover { text-decoration: underline; text-decoration-color: var(--color-accent); text-decoration-thickness: 1px; text-underline-offset: 0.15em; }
  details p { padding-bottom: var(--space-lg); max-width: 65ch; }
</style>
