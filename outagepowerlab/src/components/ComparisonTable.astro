---
import { getEntries } from 'astro:content';
import BuyButton from './BuyButton.astro';

interface Props { products: { collection: 'products'; id: string }[]; specKeys?: string[] }
const { products, specKeys: given } = Astro.props;
const items = await getEntries(products);
// Default to every spec key the products share, in first-seen order.
const specKeys = given ?? [...new Set(items.flatMap((p) => Object.keys(p.data.specs)))];
const fmt = (n: number | null) => (n == null ? 'See price' : `$${n.toLocaleString('en-US')}`);
---
{items.length > 0 && (
  <div class="table-scroll">
    <table>
      <thead>
        <tr>
          <th>Product</th>
          <th>Price</th>
          {specKeys.map((k) => <th>{k}</th>)}
          <th></th>
        </tr>
      </thead>
      <tbody>
        {items.map((p) => (
          <tr>
            <td class="name"><span class="product">{p.data.name}</span><span class="label">{p.data.brand}</span></td>
            <td>
              <span class="price">{fmt(p.data.priceUsd)}</span>
              {p.data.checked && <span class="label">on {new Date(p.data.checked).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' })}</span>}
            </td>
            {specKeys.map((k) => <td>{p.data.specs[k] ?? '–'}</td>)}
            <td><BuyButton url={p.data.url} affiliate={p.data.affiliate} /></td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
)}
<style>
  .table-scroll { margin-block: var(--space-xl); }
  table { min-width: 680px; }
  th, td { padding-right: var(--space-sm); }
  td { font-size: 0.9375rem; line-height: 1.4; }
  td:last-child { padding-right: 0; }
  .name { min-width: 170px; }
  .product, .price { display: block; font-family: var(--font-display); font-weight: 700; font-variation-settings: "wdth" 75, "opsz" 36; color: var(--color-ink); line-height: 1.15; }
  .product { font-size: var(--text-lg); }
  .price { font-size: var(--text-xl); }
  td .label { display: block; margin-top: var(--space-2xs); }
</style>
<style>
  td .btn { padding-inline: var(--space-md); }
</style>
