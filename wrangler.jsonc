// Used only if Cloudflare deploys this as a Worker (Workers Builds).
// Cloudflare Pages ignores this file; Pages uses build command `npm run build` and output `dist`.
{
  "name": "garagerecoverylab",
  "compatibility_date": "2026-11-01",
  // Build the static site before deploying, in case the dashboard has no build command.
  "build": { "command": "npm run build" },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
}
